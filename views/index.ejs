<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Frame — Feed</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/index.html">frame<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="/index.html">Feed</a><a href="/profile.html">My profile</a>
        </nav>
      </div>
    </header>
    <main>
      <p class="eyebrow">A place</p>
      <h1>Small moments, shared.</h1>
      <div class="layout">
        <section aria-label="Post feed">
          <p id="status" role="status" aria-live="polite"><%= error %></p>
          <div id="posts">
            <% posts.forEach((post) => { %>
              <article class="post">
                <header class="post-header">
                  <strong>@<%= post.author %></strong>
                  <time datetime="<%= post.createdAt %>"><%= new Date(post.createdAt).toLocaleDateString() %></time>
                </header>
                <% if (post.image) { %>
                  <img class="post-image" src="<%= post.image %>" alt="<%= post.imageAlt %>" />
                <% } %>
                <div class="post-body">
                  <p class="post-caption"><%= post.text %></p>
                  <button type="button" class="secondary" onclick="deletePost(<%= post.id %>, this)">Delete post</button>
                </div>
              </article>
            <% }); %>
          </div>
        </section>
        <aside>
          <section class="panel">
            <h2>Your next story</h2>
            <p>A photo, a thought, a little piece of your day.</p>
            <form id="post-form" action="/posts" method="post">
              <label for="post-text">Your post</label>
              <textarea
                id="post-text"
                name="text"
                rows="4"
                maxlength="1000"
                required
              ><%= text %></textarea>
              <p class="muted">
                Posting as @ava. Posts reset when the server restarts.
              </p>
              <button type="submit">Publish post</button>
            </form>
          </section>
        </aside>
      </div>
    </main>
    <script>
      async function deletePost(id, button) {
        try {
          // Ask the server to delete the post.
          const response = await fetch(`/posts/${id}/delete`, { method: "POST" });
          if (!response.ok) throw new Error("Delete failed");

          // Remove the post from the screen without reloading.
          button.closest(".post").remove();
        } catch (error) {
          alert("Could not delete the post. Please try again.");
        }
      }
    </script>
  </body>
</html>
