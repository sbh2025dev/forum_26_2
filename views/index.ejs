<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Frame — Feed</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("nav") %>
    <main>
      <p class="eyebrow">A place</p>
      <h1>Small moments, shared.</h1>
      <div class="layout">
        <section aria-label="Post feed">
          <p id="status" role="status" aria-live="polite"><%= error %></p>
          <div id="posts"><%- include("posts") %></div>
        </section>
        <aside>
          <section class="panel">
            <h2>Your next story</h2>
            <p>A photo, a thought, a little piece of your day.</p>
            <% if (user) { %>
              <form id="post-form" action="/posts" method="post" onsubmit="publishPost(this); return false">
                <label for="post-text">Your post</label>
                <textarea
                  id="post-text"
                  name="text"
                  rows="4"
                  maxlength="1000"
                  required
                ><%= text %></textarea>
                <p class="muted">
                  Posting as @<%= user.username %>. Posts are saved in MongoDB.
                </p>
                <button type="submit">Publish post</button>
              </form>
            <% } else { %>
              <p><a href="/login">Log in</a> or <a href="/signup">sign up</a> to publish a post.</p>
            <% } %>
          </section>
        </aside>
      </div>
    </main>
    <script>
      const feed = document.getElementById("posts");
      let latestRefresh = 0;

      async function refreshFeed() {
        const refresh = ++latestRefresh;
        try {
          const response = await fetch("/posts");
          if (!response.ok) return;

          const fragment = document.createElement("template");
          fragment.innerHTML = await response.text();
          if (refresh === latestRefresh && fragment.innerHTML.trim() !== feed.innerHTML.trim()) {
            feed.replaceChildren(fragment.content);
          }
        } catch (error) {
          // A feed event or stream reconnection can trigger another refresh.
        }
      }

      const feedEvents = new EventSource("/posts/events");
      feedEvents.addEventListener("open", refreshFeed);
      feedEvents.addEventListener("feed-changed", refreshFeed);

      async function publishPost(form) {
        try {
          const response = await fetch("/posts", {
            method: "POST",
            body: new URLSearchParams(new FormData(form)),
          });
          if (!response.ok) {
            alert(await response.text());
            return;
          }

          form.reset();
          await refreshFeed();
        } catch (error) {
          alert("Could not publish the post. Please try again.");
        }
      }

      async function deletePost(id, button) {
        try {
          // Ask the server to delete the post.
          const response = await fetch(`/posts/${id}/delete`, { method: "POST" });
          if (!response.ok) throw new Error("Delete failed");

          // Remove the post from the screen without reloading.
          button.closest(".post").remove();
          await refreshFeed();
        } catch (error) {
          alert("Could not delete the post. Please try again.");
        }
      }
    </script>
  </body>
</html>
