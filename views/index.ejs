<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Frame — Feed</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("nav") %>
    <main>
      <p class="eyebrow">A place</p>
      <h1>Small moments, shared.</h1>
      <div class="layout">
        <section aria-label="Post feed">
          <p id="status" role="status" aria-live="polite"><%= error %></p>
          <div id="posts">
            <%- include("posts") %>
          </div>
        </section>
        <aside>
          <section class="panel">
            <h2>Your next story</h2>
            <p>A photo, a thought, a little piece of your day.</p>
            <% if (user) { %>
              <form id="post-form" action="/posts" method="post" onsubmit="publishPost(this); return false">
                <label for="post-text">Your post</label>
                <textarea
                  id="post-text"
                  name="text"
                  rows="4"
                  maxlength="1000"
                  required
                ><%= text %></textarea>
                <p class="muted">
                  Posting as @<%= user.username %>. Posts are saved in MongoDB.
                </p>
                <button type="submit">Publish post</button>
              </form>
            <% } else { %>
              <p><a href="/login">Log in</a> or <a href="/signup">sign up</a> to publish a post.</p>
            <% } %>
          </section>
        </aside>
      </div>
    </main>
    <script>
      const feed = document.getElementById("posts");
      let feedRequest;
      let lastFeedHtml;

      async function refreshFeed() {
        feedRequest?.abort();
        const request = new AbortController();
        feedRequest = request;

        try {
          const response = await fetch("/posts", { signal: request.signal });
          if (!response.ok) return;

          const html = await response.text();
          if (request.signal.aborted || html === lastFeedHtml) return;

          feed.innerHTML = html;
          lastFeedHtml = html;
        } catch {
          // A later poll can recover from a temporary network error.
        } finally {
          if (feedRequest === request) feedRequest = undefined;
        }
      }

      setInterval(() => {
        if (!document.hidden && !feedRequest) refreshFeed();
      }, 4000);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) feedRequest?.abort();
        else refreshFeed();
      });

      async function publishPost(form) {
        try {
          const response = await fetch("/posts", {
            method: "POST",
            body: new URLSearchParams(new FormData(form)),
          });
          if (!response.ok) {
            alert(await response.text());
            return;
          }

          form.reset();
          await refreshFeed();
        } catch {
          alert("Could not publish the post. Please try again.");
        }
      }

      async function deletePost(id) {
        try {
          const response = await fetch(`/posts/${id}/delete`, { method: "POST" });
          if (!response.ok) throw new Error("Delete failed");

          await refreshFeed();
        } catch {
          alert("Could not delete the post. Please try again.");
        }
      }
    </script>
  </body>
</html>
